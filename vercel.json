{
  "framework": "vite",
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/og/events/:identifier",
      "destination": "https://api.turnapp.events/api/og/events/:identifier"
    },
    {
      "source": "/og/events/:identifier",
      "destination": "https://api.turnapp.events/api/og/events/:identifier"
    },
    {
      "source": "/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|WhatsApp|Twitterbot|LinkedInBot|Slackbot|TelegramBot|Pinterest|Discordbot|Googlebot|[Bb]ingbot|Applebot|vkShare|W3C_Validator|redditbot|Quora Link Preview|ia_archiver|Embedly|outbrain|Swiftbot).*"
        }
      ],
      "destination": "https://api.turnapp.events/api/og/events/:slug"
    },
    {
      "source": "/((?!api/|og/|backend-api/).*)",
      "destination": "/index.html"
    }
  ]
}