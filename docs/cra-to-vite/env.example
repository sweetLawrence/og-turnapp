# ==============================================================================
# Environment Variables — Example Configuration
# ==============================================================================
# Copy this file to `.env` (local dev) or `.env.production` (prod build) and
# fill in real values. Never commit the actual `.env` file — only this
# `.env.example` template should be checked into git.
#
# Vite only exposes variables prefixed with VITE_ to client-side code.
# Anything without that prefix is invisible to the frontend build — use that
# distinction to keep secrets server-side only.
# ==============================================================================

# --- API ---
# Base URL of the Laravel backend API.
# Dev:  usually http://localhost:8000/api or your local Valet/Sail URL
# Prod: your real domain, served over HTTPS
VITE_API_URL=http://localhost:8000/api

# --- App metadata ---
VITE_APP_NAME="Event Management Platform"
VITE_APP_ENV=development   # development | staging | production

# --- Auth / third-party (fill in only what's actually integrated) ---
# VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id

# --- Payments (if M-Pesa/Daraja integration is exposed to frontend) ---
# Note: Daraja consumer key/secret and passkey belong on the BACKEND (Laravel)
# only — never expose them with a VITE_ prefix, or they ship in the client
# bundle. Only put here what the frontend genuinely needs, e.g. a public
# merchant/shortcode used purely for display.
# VITE_MPESA_SHORTCODE=174379

# ==============================================================================
# PRODUCTION CHECKLIST
# ==============================================================================
# 1. VITE_API_URL must point to the production API domain over HTTPS, not
#    localhost or an IP address.
# 2. VITE_APP_ENV should be set to "production" so any conditional
#    logging/debug UI in the app is disabled.
# 3. Double-check nothing sensitive (API keys, secrets, DB credentials) has
#    been given a VITE_ prefix — those get bundled into the client-side
#    JavaScript and are publicly visible in the browser, regardless of build
#    mode.
# 4. Rebuild after changing env values — Vite inlines these at BUILD time,
#    not at runtime. Changing `.env` and redeploying without rebuilding will
#    have no effect.
# 5. Keep a separate `.env.production` (or equivalent secrets manager entry)
#    per environment — don't reuse the same file across staging and prod.
# ==============================================================================
